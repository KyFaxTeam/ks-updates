        <item>
            <!-- Titre de la mise à jour -->
            <title>Version 3.1.0</title>
            
            <!-- Description des nouveautés (affichée à l'utilisateur) -->
            <description>
                <![CDATA[
                <div style="color: black; background-color: white; font-family: Arial, sans-serif; padding: 24px; border-radius: 8px;">
                <h2>🎉 Mise à jour 3.1.0 !</h2>
                <p>Cette version apporte de nombreuses corrections et améliorations :</p>
                
                <h3>🐛 Corrections de bugs</h3>
                <ul>
                    <li><strong>Traitement</strong> : Correction de l'affichage du bon traitement</li>
                    <li><strong>Page statistique</strong> : Réparation complète</li>
                    <li><strong>Filtre période</strong> : Correction du filtre tableau de bord</li>
                    <li><strong>Devise</strong> : Affichage en FCFA au lieu de XOF</li>
                </ul>
                
                <h3>🧹 Simplifications</h3>
                <ul>
                    <li>Retrait du champ description optionnel (traitement et encaissement)</li>
                    <li>Déplacement du RDV vers l'onglet patient</li>
                    <li>Retrait des champs "Ville" et genre "Autre" (création patient)</li>
                    <li>Retrait des boutons debug et logout (page d'accueil)</li>
                </ul>
                
                <h3>✨ Améliorations</h3>
                <ul>
                    <li>Masquage automatique des champs vides (détails consultation)</li>
                    <li>Nouveau champ âge synchronisé avec la date de naissance</li>
                    <li>"Numéro patient" renommé en "Numéro client"</li>
                    <li>Dernières consultations cliquables</li>
                </ul>
                
                <p>Merci d'utiliser KySmile ! 😊</p>
                </div>
                ]]>
            </description>
            
            <!-- Date de publication (Format RFC 822) -->
            <pubDate>Mon, 19 Jan 2026 10:00:00 +0100</pubDate>

            <!-- L'élément CRITIQUE : l'endroit où se trouve le fichier d'installation -->
            <enclosure 
                url="https://github.com/KyFaxTeam/ks-updates/releases/download/v3.1.0/KySmile_Setup_3.1.0.exe" 
                sparkle:version="3.1.0+2"
                sparkle:shortVersionString="3.1.0" 
                sparkle:os="windows" 
                length="1571328" 
                type="application/octet-stream" />
                
            <!-- 
              Détails des attributs :
              - url : Lien direct vers votre installateur (.exe ou .msi)
              - sparkle:version : Le numéro APRES le "+" dans votre pubspec.yaml (le build number)
              - sparkle:shortVersionString : Le numéro AVANT le "+" dans votre pubspec.yaml (la version affichée)
              - sparkle:os : Toujours "windows" pour votre cas
              - length : Taille du fichier en octets (optionnel mais recommandé)
            -->
        </item>
